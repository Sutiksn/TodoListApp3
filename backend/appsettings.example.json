{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "postgresql://<USERNAME>:<PASSWORD>@<HOST>/<DATABASE>?sslmode=require"
  },
  "Jwt": {
    "Secret": "YOUR_SUPER_SECRET_JWT_KEY_AT_LEAST_32_BYTES_LONG_HERE",
    "Issuer": "TaskFlowEnterprise",
    "Audience": "TaskFlowUsers"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "TaskFlow Security",
    "User": "your-email@gmail.com",
    "Password": "your-gmail-app-password",
    "SenderEmail": "your-email@gmail.com"
  },
  "AdminSeed": {
    "Username": "Admin",
    "FullName": "Platform Administrator",
    "Email": "admin@yourcompany.com",
    "Password": "YourSecureAdminPassword123!"
  }
}
